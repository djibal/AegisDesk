{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Grants only for the local launcher window. Wrapped app windows (app-*) match no capability and therefore have zero IPC access.",
  "windows": ["main"],
  "platforms": ["windows", "macOS", "linux"],
  "local": true,
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-core-status",
    "allow-validate-site",
    "encapsulation-core",
    "allow-fabric",
    "allow-workspace",
    "allow-governor"
  ]
}
